MODEL="gpt-5-mini"
OPENAI_API_KEY=""
#OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
MCPO_REQUIRE_LLM=1
MCPO_REQUIRE_EMBEDDINGS=1
MCPO_EAGER_INIT=1
MCPO_WARM_EMBEDDINGS=0
EMBEDDING_MODEL="dragonkue/BGE-m3-ko"
MCPO_CONTEXT_OVERLAP=4
DATA_DIR="/Users/ibeomhun/mcpo-all/mcpo-kcd/data"

# Vector store selection: chroma | qdrant
VECTOR_STORE="chroma"

# ChromaDB indexing (when VECTOR_STORE=chroma)
CHROMA_PERSIST_DIR="/Users/ibeomhun/mcpo-all/mcpo-kcd/data/chroma"
CHUNK_SIZE=800
CHUNK_OVERLAP=300
# Force rebuild of Chroma collections on next start (0/1)
CHROMA_REBUILD=1
# Cache for repeated queries (embeddings)
EMBEDDING_CACHE_SIZE=256
# Fallback keyword mode only
#MCPO_CONTEXT_OVERLAP=4
# Hybrid retrieval (BM25 + Vector)
ENABLE_HYBRID=1
HYBRID_ALPHA=0.8  # 0..1, higher = more weight on vector
MCPO_CACHE_SIZE= #결과 캐시 크기(기본 128, 반복 질의 많으면 상향 추천).      기본 128                                                                                                                                                                
USE_CHROMA= #0으로 비활성화하면 벡터스토어(Chroma/Qdrant) 로드 회피. 기본1                                                                                                                                                                  
BM25_LAZY= #첫 검색 시에만 BM25 빌드.   기본1
HYBRID_FUSION="rrf"
EXTERNAL_NOTE_FILE="/home/ubuntu/mcpo-all/mcpo-kcd/data/kcd_kb_external_note.txt"
DEFAULT_TOP_K=3

# Qdrant settings (when VECTOR_STORE=qdrant)
# QDRANT_URL 예: http://localhost:6333 또는 https://<cloud-endpoint>
QDRANT_URL="http://localhost:6333"
# 필요시 API 키
QDRANT_API_KEY=""
